<Window x:Class="GamePriceHunter.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:GamePriceHunter.App.Localization"
        xmlns:infra="clr-namespace:GamePriceHunter.App.Infrastructure"
        xmlns:vm="clr-namespace:GamePriceHunter.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Style="{StaticResource AppWindow}"
        Title="{loc:Loc Settings_Title}"
        Width="720" Height="680" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,20,14,6">
            <StackPanel Margin="0,0,8,0">

                <!-- General -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings_General}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{loc:Loc Settings_Language}" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Name" />
                            <TextBlock Grid.Row="2" Text="{loc:Loc Settings_Theme}" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" DisplayMemberPath="Name" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Region & currency -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings_Region}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{loc:Loc Settings_Country}" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Countries}" SelectedItem="{Binding Country}" DisplayMemberPath="Name"
                                      IsTextSearchEnabled="True" TextSearch.TextPath="Name" />
                            <TextBlock Grid.Row="2" Text="{loc:Loc Settings_Currency}" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}" DisplayMemberPath="Name"
                                      IsTextSearchEnabled="True" TextSearch.TextPath="Name" />
                        </Grid>
                        <TextBlock Text="{loc:Loc Settings_RegionHint}" Style="{StaticResource FieldHint}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Search -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings_Search}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{loc:Loc Settings_MatchMode}" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MatchModes}" SelectedItem="{Binding MatchMode}" DisplayMemberPath="Name" />
                            <TextBlock Grid.Row="2" Text="{loc:Loc Settings_MaxResults}" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding MaxResultsChoices}" SelectedItem="{Binding MaxResults}" DisplayMemberPath="Name" />
                            <TextBlock Grid.Row="4" Text="{loc:Loc Settings_Timeout}" Style="{StaticResource FieldLabel}" />
                            <DockPanel Grid.Row="4" Grid.Column="1">
                                <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding TimeoutSeconds, StringFormat={}{0} s}" />
                                <Slider Minimum="5" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        Value="{Binding TimeoutSeconds}" AutomationProperties.Name="{loc:Loc Settings_Timeout}" />
                            </DockPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Stores -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings_Stores}" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Providers}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProviderSettingViewModel}">
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Border CornerRadius="4" Background="{DynamicResource Brush.SurfaceAlt}" />
                                                    <Image infra:ImageLoader.DecodeWidth="40" infra:ImageLoader.Url="{Binding IconUrl}" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                                        <Run Text="{Binding KindText, Mode=OneWay}" FontWeight="Normal" FontSize="11"
                                                             Foreground="{DynamicResource Brush.TextTertiary}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource FieldHint}"
                                                               Visibility="{Binding Note, Converter={StaticResource NotEmptyToVisibility}}" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                                          AutomationProperties.Name="{Binding Name}" />
                                            </Grid>
                                            <Grid Margin="30,8,0,2" Visibility="{Binding RequiresApiKey, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                         infra:TextBoxHelper.Placeholder="{loc:Loc Settings_ApiKeyPlaceholder}"
                                                         AutomationProperties.Name="{loc:Loc Settings_ApiKeyPlaceholder}" />
                                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                                        Content="{loc:Loc Settings_GetApiKey}"
                                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="https://isthereanydeal.com/apps/my/" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Data & about -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings_About}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource FieldHint}">
                            <Run Text="{loc:Loc About_DataLocation}" /> <Run Text="{Binding DataLocationText, Mode=OneWay}" />
                        </TextBlock>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="{loc:Loc Settings_OpenDataFolder}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,6" />
                            <Button Content="{loc:Loc Settings_OpenLogs}" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,6" />
                            <Button Content="{loc:Loc Settings_ClearCache}" Command="{Binding ClearCacheCommand}" Margin="0,0,8,6" />
                        </WrapPanel>
                        <TextBlock Text="{Binding CacheMessage}" Style="{StaticResource FieldHint}"
                                   Visibility="{Binding CacheMessage, Converter={StaticResource NotEmptyToVisibility}}" />
                        <TextBlock Text="{loc:Loc About_Disclaimer}" Style="{StaticResource FieldHint}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="22,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Common_Cancel}" IsCancel="True" MinWidth="96" Margin="0,0,10,0" />
                <Button Content="{loc:Loc Common_Save}" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="96" Click="OnSaveClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
