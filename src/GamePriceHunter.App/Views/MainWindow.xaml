<Window x:Class="GamePriceHunter.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:GamePriceHunter.App.Localization"
        xmlns:infra="clr-namespace:GamePriceHunter.App.Infrastructure"
        xmlns:vm="clr-namespace:GamePriceHunter.App.ViewModels"
        xmlns:models="clr-namespace:GamePriceHunter.Core.Models;assembly=GamePriceHunter.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Style="{StaticResource AppWindow}"
        Title="{Binding WindowTitle}"
        Language="{Binding XmlLanguage, Source={x:Static loc:Loc.Instance}}"
        Icon="/Assets/AppIcon.ico"
        Width="1280" Height="820" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Search field chrome: the TextBox inside is borderless, the frame reacts to focus. -->
        <Style x:Key="SearchFrame" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BareTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="SectionDivider" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="6,0,12,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
        </Style>

        <!-- Store / platform / region tags on offer cards -->
        <Style x:Key="KindTag" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StoreKind.Official}">
                    <Setter Property="Background" Value="{DynamicResource Brush.Kind.OfficialSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Kind.Official}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StoreKind.KeyShop}">
                    <Setter Property="Background" Value="{DynamicResource Brush.Kind.KeyShopSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Kind.KeyShop}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StoreKind.Marketplace}">
                    <Setter Property="Background" Value="{DynamicResource Brush.Kind.MarketplaceSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Kind.Marketplace}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RegionTag" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RegionCompatibility}" Value="{x:Static models:RegionCompatibility.Compatible}">
                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RegionCompatibility}" Value="{x:Static models:RegionCompatibility.Incompatible}">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InheritedTagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Offer card -->
        <DataTemplate x:Key="OfferTemplate" DataType="{x:Type vm:OfferViewModel}">
            <Border x:Name="Card" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="10" Margin="0,0,0,8" Cursor="Hand"
                    ToolTipService.InitialShowDelay="900">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" CommandParameter="{Binding}"
                                  Command="{Binding DataContext.OpenOfferCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                </Border.InputBindings>
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{loc:Loc Menu_Open}" Click="OnOpenOfferClick">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8A7;" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{loc:Loc Menu_CopyLink}" Click="OnCopyLinkClick">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE71B;" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{loc:Loc Menu_CopyTitle}" Click="OnCopyTitleClick">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8C8;" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{loc:Loc Menu_SearchTitle}" Click="OnSearchTitleClick">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE721;" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Capsule image with placeholder -->
                    <Grid Width="150" Height="70" VerticalAlignment="Center">
                        <Border CornerRadius="6" Background="{DynamicResource Brush.Placeholder}">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7FC;" FontSize="22" Foreground="{DynamicResource Brush.TextTertiary}" />
                        </Border>
                        <Image infra:ImageLoader.DecodeWidth="300" infra:ImageLoader.Url="{Binding ImageUrl}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,150,70" RadiusX="6" RadiusY="6" />
                            </Image.Clip>
                        </Image>
                    </Grid>

                    <!-- Title and tags -->
                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Title}" />
                        <WrapPanel Margin="0,7,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Grid Width="14" Height="14" Margin="0,0,6,0">
                                    <Border CornerRadius="3" Background="{DynamicResource Brush.SurfaceAlt}">
                                        <TextBlock Text="{Binding StoreInitial}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </Border>
                                    <Image infra:ImageLoader.DecodeWidth="32" infra:ImageLoader.Url="{Binding StoreIconUrl}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <TextBlock Text="{Binding StoreName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                            </StackPanel>
                            <Border Style="{StaticResource KindTag}">
                                <TextBlock Style="{StaticResource InheritedTagText}" Text="{Binding KindText}" />
                            </Border>
                            <Border Style="{StaticResource Tag}" Visibility="{Binding TypeText, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Style="{StaticResource TagText}" Text="{Binding TypeText}" />
                            </Border>
                            <Border Style="{StaticResource Tag}" Visibility="{Binding PlatformText, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Style="{StaticResource TagText}" Text="{Binding PlatformText}" />
                            </Border>
                            <Border Style="{StaticResource RegionTag}" ToolTip="{Binding RegionTooltip}"
                                    Visibility="{Binding RegionText, Converter={StaticResource NotEmptyToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE909;" FontSize="10" Margin="0,0,4,0" />
                                    <TextBlock Style="{StaticResource InheritedTagText}" Text="{Binding RegionText}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" FontSize="11" Margin="0,0,10,0"
                                       Visibility="{Binding Seller, Converter={StaticResource NotEmptyToVisibility}}">
                                <Run Text="{loc:Loc Offer_Seller}" /> <Run Text="{Binding Seller, Mode=OneWay}" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center" Background="Transparent"
                                        ToolTip="{Binding SellerRatingTooltip}"
                                        Visibility="{Binding SellerRatingText, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE735;" FontSize="10" Margin="0,0,3,0"
                                           Foreground="{DynamicResource Brush.Warning}" />
                                <TextBlock Style="{StaticResource Text.Secondary}" FontSize="11" Text="{Binding SellerRatingText}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" FontSize="11" Text="{Binding SalesText}"
                                       ToolTip="{loc:Loc Offer_SalesTooltip}"
                                       Visibility="{Binding SalesText, Converter={StaticResource NotEmptyToVisibility}}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- Price block -->
                    <StackPanel Grid.Column="2" MinWidth="110" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border HorizontalAlignment="Right" CornerRadius="4" Padding="6,1" Margin="0,0,0,3" Background="{DynamicResource Brush.SuccessSoft}"
                                Visibility="{Binding IsBest, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{loc:Loc Offer_BestPrice}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" />
                        </Border>
                        <TextBlock x:Name="Price" Text="{Binding PriceText}" FontFamily="{StaticResource Font.Display}" FontSize="19"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,0,0"
                                    Visibility="{Binding DiscountText, Converter={StaticResource NotEmptyToVisibility}}">
                            <TextBlock Text="{Binding RegularPriceText}" FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}"
                                       TextDecorations="Strikethrough" VerticalAlignment="Center" />
                            <Border CornerRadius="4" Padding="5,0" Margin="6,0,0,0" Background="{DynamicResource Brush.SuccessSoft}">
                                <TextBlock Text="{Binding DiscountText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding OriginalPriceText}" FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Right"
                                   ToolTip="{loc:Loc Offer_OriginalPriceTooltip}"
                                   Visibility="{Binding OriginalPriceText, Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>

                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE8A7;" Margin="10,0,0,0" VerticalAlignment="Center"
                            ToolTip="{loc:Loc Offer_OpenTooltip}" CommandParameter="{Binding}"
                            Command="{Binding DataContext.OpenOfferCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBest}" Value="True">
                    <Setter TargetName="Price" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Store row in the sidebar -->
        <DataTemplate x:Key="ProviderTemplate" DataType="{x:Type vm:ProviderViewModel}">
            <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="6,5" Margin="0,1" ToolTip="{Binding StatusTooltip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                    <Grid Grid.Column="1" Width="20" Height="20" Margin="8,0,8,0">
                        <Border CornerRadius="4" Background="{DynamicResource Brush.SurfaceAlt}">
                            <TextBlock Text="{Binding Initial}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Border>
                        <Image infra:ImageLoader.DecodeWidth="40" infra:ImageLoader.Url="{Binding IconUrl}" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding KindText}" Style="{StaticResource Text.Secondary}" FontSize="11" />
                    </StackPanel>
                    <Grid Grid.Column="3" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Control Style="{StaticResource Spinner}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <Border CornerRadius="9" MinWidth="24" Padding="6,1" Background="{DynamicResource Brush.SurfaceAlt}"
                                Visibility="{Binding HasCount, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding OfferCount}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Border>
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="13" Content="&#xE7BA;"
                                Foreground="{DynamicResource Brush.Warning}" ToolTip="{loc:Loc Provider_RetryTooltip}"
                                Command="{Binding DataContext.RetryProviderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding IsProblem, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72E;" FontSize="13" Foreground="{DynamicResource Brush.TextTertiary}"
                                   Visibility="{Binding IsSkipped, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Suggestion row -->
        <DataTemplate x:Key="SuggestionTemplate" DataType="{x:Type vm:SuggestionViewModel}">
            <Grid Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="80" Height="30" Margin="0,0,12,0">
                    <Border CornerRadius="4" Background="{DynamicResource Brush.Placeholder}">
                        <TextBlock x:Name="Glyph" Style="{StaticResource Text.Icon}" Text="&#xE721;" FontSize="13" Foreground="{DynamicResource Brush.TextTertiary}" />
                    </Border>
                    <Image infra:ImageLoader.DecodeWidth="160" infra:ImageLoader.Url="{Binding ImageUrl}" Stretch="UniformToFill">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,80,30" RadiusX="4" RadiusY="4" />
                        </Image.Clip>
                    </Image>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13" />
                <TextBlock Grid.Column="2" Text="{Binding PriceText}" VerticalAlignment="Center" Margin="12,0,4,0"
                           Style="{StaticResource Text.Secondary}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHistory}" Value="True">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE81C;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- Prices / Giveaways switch above the sidebar -->
        <Style x:Key="ModeTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="8,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Surface}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A list inside an outer ScrollViewer: without a scroller of its own, the mouse wheel reaches the outer one. -->
        <Style x:Key="BareListBox" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="ItemContainerStyle" Value="{StaticResource PlainListItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Giveaway card -->
        <DataTemplate x:Key="GiveawayTemplate" DataType="{x:Type vm:GiveawayViewModel}">
            <Border x:Name="Card" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}" Padding="8" Margin="0,0,10,10" Cursor="Hand"
                    ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="900">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" CommandParameter="{Binding}"
                                  Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                </Border.InputBindings>
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{loc:Loc Menu_Open}" Click="OnOpenGiveawayClick">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8A7;" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{loc:Loc Menu_CopyLink}" Click="OnCopyGiveawayLinkClick">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE71B;" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{loc:Loc Menu_CopyTitle}" Click="OnCopyGiveawayTitleClick">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8C8;" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{loc:Loc Menu_SearchTitle}" Click="OnSearchGiveawayTitleClick">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE721;" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>

                <StackPanel>
                    <!-- Cover with placeholder -->
                    <Grid Height="112">
                        <Border CornerRadius="6" Background="{DynamicResource Brush.Placeholder}">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xF133;" FontSize="26" Foreground="{DynamicResource Brush.TextTertiary}" />
                        </Border>
                        <Image infra:ImageLoader.DecodeWidth="440" infra:ImageLoader.Url="{Binding ImageUrl}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" infra:RoundedClip.Radius="6" />
                    </Grid>

                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,9,2,0" />

                    <!-- Store and tags -->
                    <DockPanel Margin="2,5,2,0">
                        <Grid DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,6,0">
                            <Border CornerRadius="3" Background="{DynamicResource Brush.SurfaceAlt}">
                                <TextBlock Text="{Binding StoreInitial}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Border>
                            <Image infra:ImageLoader.DecodeWidth="32" infra:ImageLoader.Url="{Binding StoreIconUrl}" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" Margin="6,0,0,0" Visibility="{Binding PlatformText, Converter={StaticResource NotEmptyToVisibility}}">
                            <TextBlock Style="{StaticResource TagText}" Text="{Binding PlatformText}" />
                        </Border>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" Margin="6,0,0,0" Visibility="{Binding KindText, Converter={StaticResource NotEmptyToVisibility}}">
                            <TextBlock Style="{StaticResource TagText}" Text="{Binding KindText}" />
                        </Border>
                        <TextBlock Text="{Binding StoreName}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Free, usual price, time left -->
                    <Grid Margin="2,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc Giveaway_Free}" FontFamily="{StaticResource Font.Display}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Success}" />
                                <TextBlock Text="{Binding WorthText}" FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" TextDecorations="Strikethrough"
                                           VerticalAlignment="Center" Margin="7,1,0,0"
                                           Visibility="{Binding WorthText, Converter={StaticResource NotEmptyToVisibility}}" />
                            </StackPanel>
                            <TextBlock x:Name="Time" Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8A7;" VerticalAlignment="Center"
                                ToolTip="{loc:Loc Giveaway_OpenTooltip}" CommandParameter="{Binding}"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    </Grid>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEndingSoon}" Value="True">
                    <Setter TargetName="Time" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Giveaway source row in the sidebar -->
        <DataTemplate x:Key="GiveawaySourceTemplate" DataType="{x:Type vm:GiveawaySourceViewModel}">
            <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="6,5" Margin="0,1" ToolTip="{Binding StatusTooltip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="20" Height="20" Margin="0,0,8,0">
                        <Border CornerRadius="4" Background="{DynamicResource Brush.SurfaceAlt}">
                            <TextBlock Text="{Binding Initial}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Border>
                        <Image infra:ImageLoader.DecodeWidth="40" infra:ImageLoader.Url="{Binding IconUrl}" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding KindText}" Style="{StaticResource Text.Secondary}" FontSize="11" />
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Control Style="{StaticResource Spinner}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <Border CornerRadius="9" MinWidth="24" Padding="6,1" Background="{DynamicResource Brush.SurfaceAlt}"
                                Visibility="{Binding HasCount, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Border>
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="13" Foreground="{DynamicResource Brush.Warning}"
                                   Visibility="{Binding IsProblem, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header: also the window's title bar (infra:TitleBar), so what takes clicks is IsHitTestVisibleInChrome ===== -->
        <Border x:Name="Header" Grid.Row="0" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid Height="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Image Source="/Assets/Logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource Font.Display}" FontSize="17" FontWeight="SemiBold">
                            <Run Text="Game Price" /><Run Text=" Hunter" Foreground="{DynamicResource Brush.Accent}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Search -->
                    <Grid Grid.Column="1" MaxWidth="780" Margin="28,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border x:Name="SearchFrame" Style="{StaticResource SearchFrame}" Height="40">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE721;" FontSize="16" Margin="14,0,6,0"
                                           Foreground="{DynamicResource Brush.TextTertiary}" />
                                <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource BareTextBox}"
                                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                         infra:TextBoxHelper.Placeholder="{loc:Loc Search_Placeholder}"
                                         AutomationProperties.Name="{loc:Loc Search_Placeholder}"
                                         PreviewKeyDown="OnSearchBoxPreviewKeyDown"
                                         PreviewMouseLeftButtonDown="OnSearchBoxMouseDown" PreviewMouseLeftButtonUp="OnSearchBoxMouseUp" />
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Width="30" Height="30"
                                        ToolTip="{loc:Loc Search_Clear}" Command="{Binding ClearQueryCommand}"
                                        Visibility="{Binding Query, Converter={StaticResource NotEmptyToVisibility}}" />
                                <!-- Inset evenly, with the corner radius of the frame minus the inset, so the corners run parallel. -->
                                <Grid Grid.Column="3" Margin="4,3,3,3">
                                    <Button Style="{StaticResource AccentButton}" Padding="18,0" Command="{Binding SearchCommand}"
                                            Content="{loc:Loc Search_Button}"
                                            Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <Button Padding="14,0" Command="{Binding CancelCommand}"
                                            Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Control Style="{StaticResource Spinner}" Width="14" Height="14" Margin="0,0,8,0" />
                                            <TextBlock Text="{loc:Loc Search_Stop}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <Popup x:Name="SuggestionsPopup" PlacementTarget="{Binding ElementName=SearchFrame}" Placement="Bottom"
                               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                               Width="{Binding ActualWidth, ElementName=SearchFrame}"
                               IsOpen="{Binding IsSuggestionsOpen, Mode=TwoWay}">
                            <Border Margin="0,6,0,16" Padding="6" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="10" Effect="{StaticResource Shadow.Popup}">
                                <ListBox x:Name="SuggestionsList" ItemsSource="{Binding Suggestions}" ItemTemplate="{StaticResource SuggestionTemplate}"
                                         ItemContainerStyle="{StaticResource SoftListItem}" MaxHeight="420"
                                         PreviewMouseLeftButtonUp="OnSuggestionClicked" />
                            </Border>
                        </Popup>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenSettingsCommand}" ToolTip="{Binding RegionTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE774;" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding RegionText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" Margin="4,0,0,0" ToolTip="{loc:Loc Settings_Title}"
                                Command="{Binding OpenSettingsCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" AutomationProperties.Name="{loc:Loc Window_Minimize}"
                                Click="OnMinimizeClick" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource MaximizeCaptionButton}" Click="OnMaximizeClick" />
                        <Button Style="{StaticResource CloseCaptionButton}" Click="OnCloseClick" />
                    </StackPanel>
                </Grid>

                <ProgressBar Style="{StaticResource ProgressLine}" VerticalAlignment="Bottom" Margin="0,0,0,-1"
                             Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                             Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <!-- ===== Update banner ===== -->
        <Border Grid.Row="1" DataContext="{Binding Update}" Margin="20,14,20,0" Padding="14,8,8,8"
                Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}"
                Visibility="{Binding IsBannerVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsOfferVisible, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource GhostButton}" Content="{Binding ReleasePageText}" Command="{Binding OpenReleasePageCommand}" />
                        <Button Style="{StaticResource AccentButton}" Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" Margin="6,0,0,0" />
                        <Button Style="{StaticResource GhostButton}" Content="{loc:Loc Update_Later}" Command="{Binding LaterCommand}" Margin="6,0,0,0" />
                    </StackPanel>
                    <Button Content="{loc:Loc Common_Cancel}" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE896;" FontSize="16" Margin="0,0,12,0" Foreground="{DynamicResource Brush.Accent}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding BannerText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding BannerText}" />
                    <ProgressBar Style="{StaticResource ProgressLine}" Height="3" Margin="0,6,0,0" Maximum="100" Background="{DynamicResource Brush.Border}"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Wide enough for "Официальный магазин" / "Boutique officielle" next to the offer count. -->
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="20,16,0,16">
                <!-- Mode switch -->
                <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="3" CornerRadius="10" Background="{DynamicResource Brush.SurfaceAlt}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <UniformGrid Columns="2">
                        <RadioButton Style="{StaticResource ModeTab}" GroupName="Mode" IsChecked="{Binding IsPricesMode}"
                                     AutomationProperties.Name="{loc:Loc Mode_Prices}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8EC;" FontSize="13" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:Loc Mode_Prices}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ModeTab}" GroupName="Mode" IsChecked="{Binding IsGiveawaysMode}"
                                     AutomationProperties.Name="{loc:Loc Mode_Giveaways}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xF133;" FontSize="13" Margin="0,0,7,0" />
                                <TextBlock Text="{loc:Loc Mode_Giveaways}" VerticalAlignment="Center" />
                                <Border CornerRadius="8" MinWidth="20" Padding="5,0" Margin="7,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Brush.SuccessSoft}"
                                        Visibility="{Binding Giveaways.HasGames, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Giveaways.GameCount}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Success}" />
                                </Border>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </Border>

                <Grid>
            <!-- Stores sidebar -->
            <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}" Visibility="{Binding IsPricesMode, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="8,10,8,8">
                    <Grid DockPanel.Dock="Top" Margin="6,0,2,6">
                        <TextBlock Text="{loc:Loc Stores_Header}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Padding="6,2" FontSize="11" Content="{loc:Loc Stores_All}"
                                    Command="{Binding EnableAllProvidersCommand}" />
                            <Button Style="{StaticResource GhostButton}" Padding="6,2" FontSize="11" Content="{loc:Loc Stores_None}"
                                    Command="{Binding DisableAllProvidersCommand}" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Providers}" ItemTemplate="{StaticResource ProviderTemplate}" Focusable="False" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Giveaway sources sidebar -->
            <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Card}" DataContext="{Binding Giveaways}"
                    Visibility="{Binding DataContext.IsGiveawaysMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="8,10,8,8">
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Giveaways_Sources}" Style="{StaticResource Text.Caption}" Margin="6,0,2,8" />
                    <!-- GamerPower's terms ask for a link back to them. -->
                    <TextBlock DockPanel.Dock="Bottom" Margin="6,8,6,2" FontSize="11" TextWrapping="Wrap">
                        <Hyperlink Command="{Binding OpenAttributionCommand}" ToolTip="https://www.gamerpower.com/">
                            <Run Text="{loc:Loc Giveaways_Attribution}" />
                        </Hyperlink>
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource GiveawaySourceTemplate}" Focusable="False" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
                </Grid>
            </DockPanel>

            <Grid Grid.Column="1" Margin="16,0,8,0" Visibility="{Binding IsPricesMode, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

        <!-- ===== Toolbar ===== -->
        <Grid Margin="0,16,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"
                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Grid Width="220" Margin="0,0,10,0">
                    <TextBox Text="{Binding QuickFilter, UpdateSourceTrigger=PropertyChanged}" Padding="30,12,10,12"
                             infra:TextBoxHelper.Placeholder="{loc:Loc Filter_Placeholder}" AutomationProperties.Name="{loc:Loc Filter_Placeholder}" />
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE71C;" FontSize="12" HorizontalAlignment="Left" Margin="11,0,0,0"
                               Foreground="{DynamicResource Brush.TextTertiary}" IsHitTestVisible="False" />
                </Grid>
                <ComboBox Width="200" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" DisplayMemberPath="Name"
                          AutomationProperties.Name="{loc:Loc Sort_Label}" />
            </StackPanel>

            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowOfficial}" Content="{loc:Loc Filter_Official}" ToolTip="{loc:Loc Filter_OfficialTooltip}" />
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowKeyShops}" Content="{loc:Loc Filter_KeyShops}" ToolTip="{loc:Loc Filter_KeyShopsTooltip}" />
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowMarketplaces}" Content="{loc:Loc Filter_Marketplaces}" ToolTip="{loc:Loc Filter_MarketplacesTooltip}" />
                <Border Style="{StaticResource SectionDivider}" />
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowGames}" Content="{loc:Loc Filter_Games}" />
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowDlc}" Content="{loc:Loc Filter_Dlc}" />
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowBundles}" Content="{loc:Loc Filter_Bundles}" />
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowOther}" Content="{loc:Loc Filter_Other}" ToolTip="{loc:Loc Filter_OtherTooltip}" />
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowConsoles}" Content="{loc:Loc Filter_Consoles}" ToolTip="{loc:Loc Filter_ConsolesTooltip}" />
                <Border Style="{StaticResource SectionDivider}" />
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding HideIncompatibleRegions}" ToolTip="{loc:Loc Filter_RegionTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE909;" FontSize="11" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:Loc Filter_HideRegionLocked}" />
                    </StackPanel>
                </ToggleButton>
            </WrapPanel>
        </Grid>

            <!-- Results -->
            <Grid Grid.Row="1">
                <ListBox x:Name="ResultsList" ItemsSource="{Binding Offers}" ItemTemplate="{StaticResource OfferTemplate}"
                         ItemContainerStyle="{StaticResource PlainListItem}" Padding="0,0,12,8"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                         KeyDown="OnResultsKeyDown" AutomationProperties.Name="{loc:Loc Results_Label}"
                         Visibility="{Binding AreResultsVisible, Converter={StaticResource BoolToVisibility}}" />

                <!-- Welcome, with the games free right now -->
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,16"
                            Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                        <!-- The free games need the room on small screens; the header shows the logo anyway. -->
                        <Image Source="/Assets/Logo.png" Width="72" Height="72" Opacity="0.9" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,18"
                               Visibility="{Binding Giveaways.AreHighlightsVisible, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBlock Text="{loc:Loc Welcome_Title}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="{loc:Loc Welcome_Text}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"
                                   LineHeight="20" />
                        <TextBlock Text="{loc:Loc Welcome_Hint}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"
                                   Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12" />
                    </StackPanel>

                    <!-- The right margin of the last card is outside, so the cards line up with the text above. -->
                    <StackPanel MaxWidth="906" Margin="0,24,-10,0" DataContext="{Binding Giveaways}"
                                Visibility="{Binding AreHighlightsVisible, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel Margin="2,0,10,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,4"
                                    Command="{Binding DataContext.ShowGiveawaysCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc Welcome_AllGiveaways}" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72A;" FontSize="11" Margin="7,1,0,0" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xF133;" FontSize="15" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Success}" />
                                <TextBlock Text="{loc:Loc Welcome_FreeNow}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <ListBox Style="{StaticResource BareListBox}" ItemsSource="{Binding Highlights}" ItemTemplate="{StaticResource GiveawayTemplate}"
                                 KeyDown="OnGiveawaysKeyDown" AutomationProperties.Name="{loc:Loc Welcome_FreeNow}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <TextBlock HorizontalAlignment="Right" Margin="0,0,12,0" FontSize="11">
                            <Hyperlink Command="{Binding OpenAttributionCommand}" ToolTip="https://www.gamerpower.com/">
                                <Run Text="{loc:Loc Giveaways_Attribution}" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Searching, nothing yet -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60"
                            Visibility="{Binding IsSearchingWithoutResults, Converter={StaticResource BoolToVisibility}}">
                    <Control Style="{StaticResource Spinner}" Width="36" Height="36" />
                    <TextBlock Text="{Binding SummaryText}" Margin="0,16,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>

                <!-- Nothing found / filtered out -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Margin="0,0,0,60"
                            Visibility="{Binding IsEmptyVisible, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE721;" FontSize="40" Foreground="{DynamicResource Brush.TextTertiary}" />
                    <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource Text.Title}" FontSize="18" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,8" />
                    <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <Button Content="{loc:Loc Empty_ResetFilters}" HorizontalAlignment="Center" Margin="0,16,0,0" Command="{Binding ResetFiltersCommand}"
                            Visibility="{Binding HasHiddenOffers, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
            </Grid>

            <!-- ===== Giveaways page ===== -->
            <Grid Grid.Column="1" Margin="16,0,8,0" DataContext="{Binding Giveaways}"
                  Visibility="{Binding DataContext.IsGiveawaysMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,16,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72C;" FontSize="13"
                                           Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}" />
                                <Control Style="{StaticResource Spinner}" Width="14" Height="14"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <TextBlock Text="{loc:Loc Giveaways_Refresh}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowGames}" Content="{loc:Loc Filter_Games}" />
                        <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowDlc}" Content="{loc:Loc Filter_DlcAndItems}" />
                        <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding ShowBetas}" Content="{loc:Loc Filter_Betas}" />
                    </WrapPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,2,8" Focusable="False"
                                  Visibility="{Binding IsListVisible, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <ListBox x:Name="GiveawaysList" Style="{StaticResource BareListBox}" ItemsSource="{Binding Items}"
                                     ItemTemplate="{StaticResource GiveawayTemplate}" KeyDown="OnGiveawaysKeyDown"
                                     AutomationProperties.Name="{loc:Loc Mode_Giveaways}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="224" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                            <StackPanel Visibility="{Binding HasUpcoming, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Loc Giveaways_Upcoming}" Style="{StaticResource Text.Subtitle}" Margin="2,6,0,10" />
                                <ListBox Style="{StaticResource BareListBox}" ItemsSource="{Binding Upcoming}" ItemTemplate="{StaticResource GiveawayTemplate}"
                                         KeyDown="OnGiveawaysKeyDown" AutomationProperties.Name="{loc:Loc Giveaways_Upcoming}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemWidth="224" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Loading, nothing yet -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,60"
                                Visibility="{Binding IsLoadingWithoutItems, Converter={StaticResource BoolToVisibility}}">
                        <Control Style="{StaticResource Spinner}" Width="36" Height="36" />
                        <TextBlock Text="{loc:Loc Giveaways_Loading}" Margin="0,16,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>

                    <!-- Nothing free, or all of it filtered out -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Margin="0,0,0,60"
                                Visibility="{Binding IsEmptyVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xF133;" FontSize="40" Foreground="{DynamicResource Brush.TextTertiary}" />
                        <TextBlock Text="{loc:Loc Giveaways_EmptyTitle}" Style="{StaticResource Text.Title}" FontSize="18" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,8" />
                        <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>

                    <!-- No source answered -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Margin="0,0,0,60"
                                Visibility="{Binding IsFailedVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="40" Foreground="{DynamicResource Brush.TextTertiary}" />
                        <TextBlock Text="{loc:Loc Giveaways_FailedTitle}" Style="{StaticResource Text.Title}" FontSize="18" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,8" />
                        <TextBlock Text="{loc:Loc Giveaways_FailedText}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <Button Content="{loc:Loc Giveaways_Retry}" HorizontalAlignment="Center" Margin="0,16,0,0" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" Style="{StaticResource Text.Secondary}" FontSize="11" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7BA;" FontSize="11" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Warning}"
                               Visibility="{Binding AreRatesStale, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding RatesText}" Style="{StaticResource Text.Secondary}" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
