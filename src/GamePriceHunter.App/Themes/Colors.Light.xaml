<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Window">#F4F5F8</Color>
    <Color x:Key="Color.Text">#15181E</Color>
    <Color x:Key="Color.Shadow">#7A8599</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="#F4F5F8" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F0F2F6" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#E6E9EF" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#FAFAFC" />
    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E1E4EA" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#C9CED8" />

    <SolidColorBrush x:Key="Brush.Text" Color="#15181E" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5A6170" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#8C93A1" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#2F6BFF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#4A7EFF" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#2459D9" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E5EDFF" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Success" Color="#0E9A5E" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#DDF5EA" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#B7790B" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#FBF0D8" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#D23F3F" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FBE3E3" />

    <SolidColorBrush x:Key="Brush.Kind.Official" Color="#2F6BFF" />
    <SolidColorBrush x:Key="Brush.Kind.OfficialSoft" Color="#E5EDFF" />
    <SolidColorBrush x:Key="Brush.Kind.KeyShop" Color="#7B4FD6" />
    <SolidColorBrush x:Key="Brush.Kind.KeyShopSoft" Color="#EEE6FC" />
    <SolidColorBrush x:Key="Brush.Kind.Marketplace" Color="#B86E00" />
    <SolidColorBrush x:Key="Brush.Kind.MarketplaceSoft" Color="#FCEFD9" />

    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#C3C8D2" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#A9B0BD" />
    <SolidColorBrush x:Key="Brush.Placeholder" Color="#E9ECF1" />

    <!-- Close button of the title bar: Windows' own red. -->
    <SolidColorBrush x:Key="Brush.CloseHover" Color="#C42B1C" />
    <SolidColorBrush x:Key="Brush.ClosePressed" Color="#C94033" />
</ResourceDictionary>
